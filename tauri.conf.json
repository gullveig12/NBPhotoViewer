{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NBPhotoViewer",
  "version": "1.2.3",
  "identifier": "local.nbphotoviewer.app",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [{"title": "NBPhotoViewer", "width": 1440, "height": 920, "minWidth": 900, "minHeight": 600}],
    "security": {"csp": "default-src 'self'; worker-src 'self'; img-src 'self' blob: data: http://nbphoto.localhost nbphoto:; connect-src 'self' ipc: http://ipc.localhost http://nbphoto.localhost nbphoto:; style-src 'self' 'unsafe-inline'"}
  },
  "bundle": {"active": false, "icon": ["icons/icon.ico", "icons/icon.png"]}
}
